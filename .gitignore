# ============================================================
# .gitignore — Espacios Universitarios UFPS
# ============================================================

# --- OS & editors ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# --- Environment & secrets (NUNCA subir) ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
secrets/

# --- Claude Code ---
.claude/

# ============================================================
# Python / Django
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / dist
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Logs & misc
pip-log.txt
pip-delete-this-directory.txt
*.log
local_settings.py

# Bases de datos locales
db.sqlite3
db.sqlite3-journal

# Testing
.tox/
.nox/
.hypothesis/
.pytest_cache/
coverage/
*.cover
*.py,cover
nosetests.xml
coverage.xml

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Entornos virtuales
.venv/
venv/
ENV/
env/

# Django
**/media/
**/staticfiles/

# ============================================================
# Node / Next.js
# ============================================================
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build
.next/
out/

# Misc tooling
.turbo/
.vercel
.eslintcache
*.tsbuildinfo
.node_repl_history
*.tgz
.yarn-integrity
.npm
.nyc_output/

# ============================================================
# Docker
# ============================================================
# No ignorar docker-compose.yml ni Dockerfile — son parte del proyecto
# Ignorar overrides locales si los hubiera
docker-compose.override.yml
